{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned existing-only MLB reconciliation allowlist v1",
  "$comment": "Runtime also enforces exact returned PK equality, distinct existing IDs, additive source transition, canonical franchises, ISO aware Pacific starts and strict raw payload hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domain", "target_date", "payload_sha256", "games"],
  "properties": {
    "version": {"const": 1},
    "domain": {"const": "MLB"},
    "target_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "games": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/game"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_name", "external_game_id"],
      "properties": {
        "source_name": {"enum": ["odds_api", "mlb_stats"]},
        "external_game_id": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["game_pk", "home_team", "away_team", "expected_start", "existing_game_id", "current_sources", "resulting_sources"],
      "properties": {
        "game_pk": {"type": "integer", "minimum": 1},
        "existing_game_id": {"type": "integer", "minimum": 1},
        "home_team": {"type": "string", "minLength": 1},
        "away_team": {"type": "string", "minLength": 1},
        "expected_start": {"type": "string", "format": "date-time"},
        "current_sources": {"$ref": "#/$defs/sources"},
        "resulting_sources": {"$ref": "#/$defs/sources"}
      }
    }
  }
}
